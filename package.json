{
  "name": "tradefolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs');fs.mkdirSync('public/assets',{recursive:true});fs.copyFileSync('public/icon-512.png','public/assets/icon-512.png');if(fs.existsSync('public/icon-192.png'))fs.copyFileSync('public/icon-192.png','public/assets/icon-192.png');\" && npm run fonts:pdf",
    "build:tailwind": "tailwindcss -i ./styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "fonts:pdf": "node scripts/download-pdf-fonts.mjs",
    "build": "npm run build:tailwind && tsc --noEmit && vite build",
    "build:skip-check": "npm run build:tailwind && vite build",
    "preview": "vite preview",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:sync:android": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:sync:ios": "node node_modules/@capacitor/cli/bin/capacitor sync ios && node scripts/ios-patch-capacitor-plugins.mjs && node scripts/ios-strip-pwa.mjs",
    "cap:open:android": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:open:ios": "node node_modules/@capacitor/cli/bin/capacitor open ios",
    "build:ios": "npm run build && rm -rf ios/App/App/public && mkdir -p ios/App/App/public && cp -R dist/* ios/App/App/public/ && node scripts/ios-strip-pwa.mjs",
    "ios": "npm run build:ios && npm run cap:sync:ios && npm run cap:open:ios",
    "android:build": "npm run build && npm run cap:sync:android",
    "android:dev": "npm run build && npm run cap:sync:android && npm run cap:open:android",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@google/genai": "^1.31.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
